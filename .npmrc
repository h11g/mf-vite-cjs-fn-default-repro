# Install the two local `file:` packages as real copies under node_modules
# instead of symlinks, so their resolved ids sit inside node_modules — which is
# what Vite's default `build.commonjsOptions.include: [/node_modules/]` matches.
# In a real project these two are ordinary registry dependencies and no setting
# is needed; this only makes the repro self-contained.
install-links=true
